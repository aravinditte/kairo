# Kairo backend configuration (copy to .env for local tooling; the API reads
# real environment variables — see docs/api.md and README for the full table).
KAIRO_ENV=development
KAIRO_HTTP_ADDR=:8080
# Empty = in-memory demo storage (non-durable, clearly logged). Set for PostgreSQL:
# KAIRO_DATABASE_URL=postgres://kairo:kairo@localhost:5432/kairo?sslmode=disable
KAIRO_DATABASE_URL=
KAIRO_ADMIN_TOKEN=kairo-dev-admin
KAIRO_LOG_LEVEL=info
KAIRO_MAX_OTLP_BODY_BYTES=4194304
KAIRO_MAX_SPANS_PER_BATCH=1000
KAIRO_QUERY_TIMEOUT=10s
KAIRO_DEFAULT_RETENTION_DAYS=7
KAIRO_DEMO_MODE=true
KAIRO_SEED_DEMO=true
KAIRO_CHECKOUT_URL=http://localhost:8081

# Demo services
KAIRO_ENDPOINT=http://localhost:8080/v1/traces
KAIRO_API_KEY=kairo-dev-key

# Frontend (web/.env.example has the same keys)
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_SCENARIO_SEED=42
